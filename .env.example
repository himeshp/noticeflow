# Copy this to .env and fill in real values. NEVER commit .env.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Models (verify GA-served IDs on Vertex for your region)
MODEL_FLASH=gemini-2.5-flash
MODEL_PRO=gemini-2.5-pro

# Vertex AI Search (Discovery Engine): location must be global/us/eu (NOT a zone)
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_DATASTORE_ID=your-datastore-id
GCS_CORPUS_BUCKET=your-bucket-gst-corpus

# Set true to FORBID the ungrounded fallback citation (deploy/demo). The deploy
# script and the cockpit force grounding on regardless; leave false only for
# local dev-without-datastore. If true and the datastore id is empty, startup raises.
NOTICEFLOW_REQUIRE_DATASTORE=false

# Set true to wrap Drafter<->Critic in an ADK LoopAgent (deterministic review +
# re-draft, capped at 2 iterations) before the human gate. Default false = the
# proven linear pipeline.
NOTICEFLOW_ENABLE_REVIEW_LOOP=false

# Confidence-gated human escalation (#3.8). KNOWN notices classified below this
# 0-1 threshold are routed to a human (reviewer_status=NEEDS_HUMAN) instead of
# presented as ready to file. Default 0.55.
NOTICEFLOW_CONFIDENCE_THRESHOLD=0.55

# Agent Engine deploy staging bucket (created by/for scripts/deploy_agent_engine.py)
AGENT_ENGINE_STAGING_BUCKET=gs://your-agent-staging-bucket
