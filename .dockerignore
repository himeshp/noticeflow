# Keep the build context small and secret-free. Config comes from Cloud Run env
# vars + ADC, never from a baked-in .env.
.git
.gitignore
.env
.env.*
.venv
venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.mypy_cache

# Heavy / irrelevant at runtime
node_modules
frontend/node_modules
frontend/src
corpus
tests
docs
scripts
*.md
.claude
